# Dev-Lite Environment Configuration
# Base URL
BASE_URL=https://dev-lite.mybahmni.in

# Application URLs
LOGIN_URL=https://dev-lite.mybahmni.in/bahmni/home/index.html#/login

# Credentials - Multiple Users
# Passwords are injected from GitHub secrets in CI; set them locally in a .env.local override or export them before running tests.
# Admin User
USER_ADMIN_USERNAME=superman
USER_ADMIN_PASSWORD=

# Doctor User
USER_DOCTOR_USERNAME=doctor_auto
USER_DOCTOR_PASSWORD=

# Nurse User
USER_NURSE_USERNAME=nurse
USER_NURSE_PASSWORD=

# Receptionist User
USER_RECEPTIONIST_USERNAME=receptionist
USER_RECEPTIONIST_PASSWORD=

USER_LAB_USERNAME=labUser
