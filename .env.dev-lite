# Default User (fallback)
DEFAULT_USER=admin

# Default Settings
DEFAULT_LOCALE=string:en
DEFAULT_LOCATION=OPD-1

# Playwright Configuration
HEADLESS=false
TIMEOUT=30000
SLOW_MO=100
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
IGNORE_HTTPS_ERRORS=true
NODE_TLS_REJECT_UNAUTHORIZED=0

