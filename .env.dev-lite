TIMEOUT=30000
SLOW_MO=100
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
IGNORE_HTTPS_ERRORS=true
NODE_TLS_REJECT_UNAUTHORIZED=0

