{
  "type": "object",
  "required": ["resourceType", "id", "identifier", "name", "gender", "birthDate"],
  "properties": {
    "resourceType": { "const": "Patient" },
    "id": { "type": "string", "minLength": 1 },
    "identifier": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["value", "type"],
        "properties": {
          "value": { "type": "string", "minLength": 1 },
          "type": {
            "type": "object",
            "required": ["coding"],
            "properties": {
              "coding": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["code"],
                  "properties": { "code": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "name": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["given", "family"],
        "properties": {
          "given": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "family": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gender": { "type": "string", "enum": ["male", "female", "other", "unknown"] },
    "birthDate": { "type": "string", "minLength": 4 }
  }
}
