# Copy this file to `.env` in the same directory before running `docker compose up`.
# `.env` is ignored by git (see .gitignore).

# ------------------------------------------------------------
# Public API URL — used by the UI container to reach the API.
# The URL must be reachable from the browser that opens the dashboard.
#
#   Local host testing:     http://localhost:5050
#   AWS shared server:      http://<ec2-public-ip>:5050  (or the reverse-proxy URL)
# ------------------------------------------------------------
ALLURE_DOCKER_PUBLIC_API_URL=http://localhost:5050

# ------------------------------------------------------------
# Auth — leave disabled for local testing. Enable when hosting on AWS.
# ------------------------------------------------------------
SECURITY_ENABLED=0
SECURITY_USER=admin
SECURITY_PASS=change-me

# When SECURITY_ENABLED=1, keep viewer (read-only) endpoints open so the
# dashboard is browsable without login. POSTs still require auth.
MAKE_VIEWER_ENDPOINTS_PUBLIC=1
